Package: RFDose
Type: Package
Title: Deterministic and stochastic radiofrequency electromagnetic field (RF-EMF) dose calculator
Version: 2.0.1
Authors@R: c(
    person(given = "Irina", family = "Wipf", email = "irina.wipf@swisstph.ch", role = c("aut", "cre")),
    person(given = "Hamed", family = "Jalilian", role = c("ctb")),
    person(given = "Nicolas", family = "Loizeau", email = "nicolas.loizeau@swisstph.ch", role = c("aut")),
