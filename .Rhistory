#| label: specify_file_locations
PARENT_Q  <- file.path(here(),
"files",
"output",
"guardian_questionnaire_clean_20250401.rds")
OUTPUT    <- file.path(here(),
"files",
"output",
"guardian_questionnaire_clean_withderivedvar_20250401.rds")
#| label: read_input_files
parent_q <- read_rds(PARENT_Q)
#| label: derive_highest_gua_edu
# Define order of education levels
edu_levels <- c("nonschooling",
"compulsory",
"apprenticeship",
"gymnasium",
"higher",
"university")
# Replace empty string in partner education with NA
parent_q <- parent_q %>%
mutate(gua_part_edu = na_if(gua_part_edu, ""))
# Order parent and partner education as defined
parent_q$gua_edu      <- factor(parent_q$gua_edu,
levels  = edu_levels,
ordered = TRUE)
parent_q$gua_part_edu <- factor(parent_q$gua_part_edu,
levels  = edu_levels,
ordered = TRUE)
# Take maximum level of either parent or partner education, ignore NAs
parent_q$highest_gua_edu <- pmax(parent_q$gua_edu, parent_q$gua_part_edu,
na.rm = TRUE)
