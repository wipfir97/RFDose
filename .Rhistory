"guardian_questionnaire_clean_withderivedvar_20250401.rds")
OUTPUT
#| label: read_input_files
parent_q <- read_rds(PARENT_Q)
#| label: specify_file_locations
PARENT_Q  <- file.path(here(),
"files",
"output",
"guardian_questionnaire_clean_20250401.rds")
OUTPUT    <- file.path(here(),
"files",
"output",
"guardian_questionnaire_clean_withderivedvar_20250401.rds")
#| label: read_input_files
parent_q <- read_rds(PARENT_Q)
#| label: derive_highest_gua_edu
# Define order of education levels
edu_levels <- c("nonschooling",
"compulsory",
"apprenticeship",
"gymnasium",
"higher",
"university")
# Replace empty string in partner education with NA
parent_q <- parent_q %>%
mutate(gua_part_edu = na_if(gua_part_edu, ""))
# Order parent and partner education as defined
parent_q$gua_edu      <- factor(parent_q$gua_edu,
levels  = edu_levels,
ordered = TRUE)
parent_q$gua_part_edu <- factor(parent_q$gua_part_edu,
levels  = edu_levels,
ordered = TRUE)
# Take maximum level of either parent or partner education, ignore NAs
parent_q$highest_gua_edu <- pmax(parent_q$gua_edu, parent_q$gua_part_edu,
na.rm = TRUE)
# Test if it worked
parent_q %>% select(gua_edu, gua_part_edu, highest_gua_edu) %>% head()
#| label: derive_highest_gua_empl_prof
# Re-coding of parental occupation
### Coding based on ISCO skill level:
### skill level 3 & 4: "High" -
### Managers, professionals, technicians and associate professionals - Chief Executives, Senior Officials and Legislators, Administrative and Commercial Managers, Production and Specialized Services Managers,
### Hospitality, Retail and Other Services Managers, Science and Engineering Professionalism, Health Professionals, Teaching Professionals,
### Business and Administration Professionals, Information and Communications Technology Professionals, Legal, Social and Cultural Professionals, Commissioned Armed Forces Officers, Science and Engineering Associate Professionals,
### Health Associate Professionals, Business and Administration Associate Professionals, Legal, Social, Cultural and Related Associate Professionals, Information and Communications Technicians,
### skill level 2: "medium" -
### General and Keyboard Clerks, Customer Services Clerks, Numerical and Material Recording Clerks, Other Clerical Support Workers, Personal Services Workers,
### Sales Workers, Personal Care Workers, Protective Services Workers, Building and Related Trades Workers (excluding Electricians), Drivers and Mobile Plant Operators,
### Electrical and Electronic Trades Workers, Non-commissioned Armed Forces Officers
### skill level 1: "low" -
### Market-oriented Skilled Agricultural Workers, Market-oriented Skilled Forestry, Fishery and Hunting Workers, Subsistence Farmers, Fishers, Hunters and Gatherers,
### Metal, Machinery and Related Trades Workers, Handicraft and Printing Workers, Food Processing, Woodworking, Garment and Other Craft and Related Trades Workers,
### Stationary Plant and Machine Operators, Assemblers, Cleaners and Helpers, Agricultural, Forestry and Fishery Labourers, Labourers in Mining, Construction, ,
### Manufacturing and Transport, Food Preparation Assistants, Street and Related Sales and Services Workers, Refuse Workers and Other Elementary Workers, Armed Forces Occupations, Other Ranks
parent_q <- parent_q |>
mutate(parent_job_ses = case_when(
gua_empl_prof %in% c(11, 12, 13, 14, 21, 22, 23, 24, 25, 26, 1, 31, 32, 33, 34) ~ "High SES",
gua_empl_prof %in% c(35, 41, 42, 43, 44, 51, 52, 53, 54, 2, 83, 74, 71) ~ "Medium SES",
gua_empl_prof %in% c(61, 62, 63, 72, 73, 75, 81, 82, 91, 92, 93, 94, 95, 96, 3) ~ "Low SES",
TRUE ~ NA_character_
))
parent_q <- parent_q %>%
mutate(parent_job_ses_coded = case_when(
parent_job_ses == "Low SES" ~ 1,
parent_job_ses == "Medium SES" ~ 2,
parent_job_ses == "High SES" ~ 3,
TRUE ~ NA_real_
))
table(parent_q$parent_job_ses_coded)
parent_q <- parent_q |>
mutate(partner_job_ses = case_when(
gua_part_empl_prof %in% c(11, 12, 13, 14, 21, 22, 23, 24, 25, 26, 1, 31, 32, 33, 34) ~ "High SES",
gua_part_empl_prof %in% c(35, 41, 42, 43, 44, 51, 52, 53, 54, 2, 83, 74, 71) ~ "Medium SES",
gua_part_empl_prof %in% c(61, 62, 63, 72, 73, 75, 81, 82, 91, 92, 93, 94, 95, 96, 3) ~ "Low SES",
TRUE ~ NA_character_
))
parent_q <- parent_q %>%
mutate(partner_job_ses_coded = case_when(
partner_job_ses == "Low SES" ~ 1,
partner_job_ses == "Medium SES" ~ 2,
partner_job_ses == "High SES" ~ 3,
TRUE ~ NA_real_
))
table(parent_q$partner_job_ses_coded)
# Difference in total numbers as some parents are divorced
# Take maximum level of either parent or partner employment, ignore NAs
parent_q$highest_empl_prof <- pmax(parent_q$parent_job_ses_coded, parent_q$partner_job_ses_coded, na.rm = TRUE)
### replace NA values with the value from partner
parent_q <- parent_q %>%
mutate(highest_empl_prof = ifelse(
is.na(highest_empl_prof),
partner_job_ses_coded,
highest_empl_prof
))
### double check output
table(parent_q$highest_empl_prof)
### tabulate data and check NA's
parent_q %>%
count(highest_empl_prof) %>%
mutate(Percentage = round(100 * n / sum(n), 1))
parent_q[is.na(parent_q$highest_empl_prof), c("id_g", "highest_empl_prof", "parent_job_ses", "partner_job_ses_coded")]
### three participants with NA values for both parents: 10054, 10157, 10289
#| label: derive_gua_nation
# Derive parents nationality
# Swiss vs. EU vs. non EU
parent_q <- parent_q %>%
mutate(parent_nat = case_when(
gua_nation_ch == 1    ~ "Swiss",
gua_nation_eu == 1    ~ "EU",
gua_nation_noneu == 1 ~ "Non-EU",
TRUE ~ NA_character_
))
table(parent_q$parent_nat)
parent_q <- parent_q %>%
mutate(partner_nat = case_when(
gua_part_nation_ch == 1    ~ "Swiss",
gua_part_nation_eu == 1    ~ "EU",
gua_part_nation_noneu == 1 ~ "Non-EU",
TRUE ~ NA_character_
))
table(parent_q$partner_nat)
#| label: save_output_rds
write_rds(parent_q, file = OUTPUT)
#| label: save_output_rds
write_rds(parent_q, file = OUTPUT)
#| label: save_output_rds
write_rds(parent_q, file = OUTPUT)
