#| label: load_required_packages
#| output: False
library(here)
library(tidyverse)
library(knitr)
#| label: set_knitr_options
# Ensure that working directory is in this project's root directory
opts_knit$set(root.dir = here())
OUTPUT    <- file.path(here(),
"files",
